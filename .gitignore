# CST Studio Suite solver and cache output
# Large solver/mesh/result directories are never committed. See cst/README.md.
*.cst
Result/
Model/
*.rex
*.sim
*.mod
*.pid
*.log
*.tmp
*.bak
*.cst.bak
Backup/
*_Backup/
*.hlg
*.m3d
*.emc
*.mmm
*.dsp
*.par~
Temp/
temp/
DesignEnvironment*.log

# `Model/` and `Result/` above are CST solver output directories. Git's ignore
# matching is case-insensitive on macOS (core.ignorecase), so those two rules also
# match `figures/model/` and `figures/results/`, which are tracked figure
# directories. Re-include them explicitly, or the model screenshots and the result
# plots are silently dropped at commit time with no warning.
!figures/model/
!figures/model/**
!figures/results/
!figures/results/**

# Mesh and field dumps
*.mesh
*.msh
*.h5
*.vtk

# Windows virtual-machine artefacts
*.vhdx
*.vmdk
*.vdi
*.vmx
$RECYCLE.BIN/
Thumbs.db
desktop.ini

# macOS
.DS_Store
._*

# Editors and Python tooling
.vscode/
.idea/
__pycache__/
*.pyc
.venv/
venv/

# Licensed source material. See references/README.md.
references/pdf/
*.pdf

# The generated report deliverables are tracked despite the *.pdf rule above.
!deliverables/*.pdf

# Large exports that belong in a release or in Git LFS
results/raw/**/*.zip
results/raw/**/*.7z

# Intermediate output of tools/report_build/build.sh. The DOCX and PDF are
# tracked; the first-pass PDF, the page map and the preview renders are not.
deliverables/.build/
deliverables/*.outline.json
